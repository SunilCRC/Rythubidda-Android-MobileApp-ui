# ─────────────────────────────────────────────────────────────────────────
#  STAGING / internal-testing build — points at the DEV backend.
#
#  Use this for Play "Internal testing" uploads while features are still
#  being validated:
#      cd android && ENVFILE=.env.staging ./gradlew bundleRelease
#
#  Why not .env.production: the production server currently runs an older
#  backend build. As of 2026-08-06 these endpoints 404 there but work on
#  dev — todays-deals/current, farmers/todays-farmer, reviews/approved,
#  first-order-discount, delivery-centers. Shipping calculation and the
#  whole home feed depend on them. Switch back to .env.production only
#  AFTER the current backend is deployed to production.
# ─────────────────────────────────────────────────────────────────────────

API_BASE_URL=https://dev-api.rythubidda.com
API_BASE_URL_FALLBACK=https://dev-api.rythubidda.com

API_TIMEOUT_MS=30000
ENV=staging

# ── Google Maps / Places / Geocoding ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyDUV0jr9CfmaZF1k_S0ZK8VGDqgZQQI2B0

# Signing-certificate SHA-1 (no colons) sent as X-Android-Cert.
# Builds DISTRIBUTED THROUGH PLAY are re-signed by Google, so the value
# that works at runtime is the "App signing key certificate" SHA-1 from
#     Play Console > Test and release > Setup > App signing
# This is the PLAY app-signing SHA-1 (Google re-signs every bundle it
# distributes), which is what Play-installed builds present at runtime.
# It must ALSO be registered in the API key's Android restrictions in
# the Google Cloud console.
#   upload key (direct installs from this PC): 47A58E8491F03F27E4E6B6C2700675E756088355
#   debug keystore (emulator):                5E8F16062EA3CD2C4A0D547876BAA6F38CABF625
GOOGLE_MAPS_CERT_SHA1=34F6B2EEC52C65980073B0CD43946F46AC0574C9
